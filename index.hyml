<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Sales Analytics Dashboard</title>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<style>
* {
    box-sizing: border-box;
    font-family: Arial, sans-serif;
}

body {
    margin: 0;
    background: #f1f5f9;
    color: #1e293b;
}

header {
    background: #10233f;
    color: white;
    padding: 30px;
}

header p {
    color: #cbd5e1;
}

.container {
    max-width: 1100px;
    margin: 30px auto;
    padding: 15px;
}

.cards {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 15px;
    margin: 25px 0;
}

.card, .panel {
    background: white;
    padding: 22px;
    border-radius: 12px;
    box-shadow: 0 3px 12px #00000008;
}

.card p {
    color: #64748b;
}

.card h2 {
    font-size: 23px;
}

.charts {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 20px;
    margin-bottom: 25px;
}

.chartbox {
    height: 300px;
    position: relative;
}

select {
    padding: 10px;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
}

table {
    width: 100%;
    border-collapse: collapse;
}

th, td {
    padding: 13px;
    text-align: left;
    border-bottom: 1px solid #e2e8f0;
}

th {
    background: #f8fafc;
}

.tablebox {
    overflow-x: auto;
}

footer {
    text-align: center;
    padding: 25px;
    color: #64748b;
}

@media(max-width:700px) {
    .cards {
        grid-template-columns: repeat(2, 1fr);
    }

    .charts {
        grid-template-columns: 1fr;
    }
}
</style>
</head>

<body>

<header>
    <h1>Sales Analytics Dashboard</h1>
    <p>Business Intelligence | Sales Performance Analysis</p>
</header>

<main class="container">

    <h2>Business Overview</h2>

    <select id="region" onchange="updateDashboard()">
        <option value="All">All Regions</option>
        <option value="North">North</option>
        <option value="South">South</option>
        <option value="East">East</option>
        <option value="West">West</option>
    </select>

    <section class="cards">
        <div class="card">
            <p>Total Revenue</p>
            <h2 id="revenue">₹0</h2>
        </div>

        <div class="card">
            <p>Total Profit</p>
            <h2 id="profit">₹0</h2>
        </div>

        <div class="card">
            <p>Total Orders</p>
            <h2 id="orders">0</h2>
        </div>

        <div class="card">
            <p>Average Order Value</p>
            <h2 id="average">₹0</h2>
        </div>
    </section>

    <section class="charts">
        <div class="panel">
            <h3>Monthly Revenue</h3>
            <div class="chartbox">
                <canvas id="salesChart"></canvas>
            </div>
        </div>

        <div class="panel">
            <h3>Revenue by Region</h3>
            <div class="chartbox">
                <canvas id="regionChart"></canvas>
            </div>
        </div>
    </section>

    <section class="panel">
        <h3>Product Performance</h3>
        <div class="tablebox">
            <table>
                <thead>
                    <tr>
                        <th>Product</th>
                        <th>Region</th>
                        <th>Revenue</th>
                        <th>Profit</th>
                    </tr>
                </thead>
                <tbody id="salesTable"></tbody>
            </table>
        </div>
    </section>

</main>

<footer>
    Sales Analytics Dashboard | Built with HTML, CSS and JavaScript
</footer>

<script>
const data = [
    {month:"Jan",product:"Laptop",region:"North",revenue:85000,profit:15000},
    {month:"Jan",product:"Phone",region:"South",revenue:45000,profit:9000},
    {month:"Feb",product:"Tablet",region:"East",revenue:30000,profit:6000},
    {month:"Feb",product:"Laptop",region:"West",revenue:95000,profit:18000},
    {month:"Mar",product:"Phone",region:"North",revenue:55000,profit:11000},
    {month:"Mar",product:"Headphones",region:"South",revenue:20000,profit:5000},
    {month:"Apr",product:"Laptop",region:"East",revenue:105000,profit:21000},
    {month:"Apr",product:"Tablet",region:"West",revenue:35000,profit:7000},
    {month:"May",product:"Phone",region:"North",revenue:65000,profit:13000},
    {month:"May",product:"Headphones",region:"East",revenue:25000,profit:6000},
    {month:"Jun",product:"Laptop",region:"South",revenue:115000,profit:23000},
    {month:"Jun",product:"Tablet",region:"North",revenue:40000,profit:9000},
    {month:"Jul",product:"Phone",region:"West",revenue:60000,profit:12000},
    {month:"Jul",product:"Laptop",region:"East",revenue:100000,profit:20000},
    {month:"Aug",product:"Headphones",region:"South",revenue:28000,profit:7000},
    {month:"Aug",product:"Tablet",region:"North",revenue:42000,profit:9000},
    {month:"Sep",product:"Laptop",region:"West",revenue:120000,profit:25000},
    {month:"Sep",product:"Phone",region:"East",revenue:70000,profit:15000},
    {month:"Oct",product:"Tablet",region:"South",revenue:38000,profit:8000},
    {month:"Oct",product:"Headphones",region:"North",revenue:32000,profit:8000},
    {month:"Nov",product:"Laptop",region:"North",revenue:130000,profit:27000},
    {month:"Nov",product:"Phone",region:"West",revenue:75000,profit:16000},
    {month:"Dec",product:"Laptop",region:"South",revenue:140000,profit:30000},
    {month:"Dec",product:"Tablet",region:"East",revenue:50000,profit:11000}
];

let salesChart, regionChart;

function money(value) {
    return "₹" + Math.round(value).toLocaleString("en-IN");
}

function updateDashboard() {
    const selected = document.getElementById("region").value;

    const rows = selected === "All"
        ? data
        : data.filter(item => item.region === selected);

    const revenue = rows.reduce((sum,item) => sum + item.revenue,0);
    const profit = rows.reduce((sum,item) => sum + item.profit,0);

    document.getElementById("revenue").textContent = money(revenue);
    document.getElementById("profit").textContent = money(profit);
    document.getElementById("orders").textContent = rows.length;
    document.getElementById("average").textContent =
        money(rows.length ? revenue / rows.length : 0);

    const months = ["Jan","Feb","Mar","Apr","May","Jun",
                    "Jul","Aug","Sep","Oct","Nov","Dec"];

    const monthly = months.map(month =>
        rows.filter(item => item.month === month)
            .reduce((sum,item) => sum + item.revenue,0)
    );

    if (salesChart) salesChart.destroy();

    salesChart = new Chart(document.getElementById("salesChart"), {
        type: "line",
        data: {
            labels
